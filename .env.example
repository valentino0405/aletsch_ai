# ============================================================
# Aletsch AI — environment template
# Copy to `.env` and fill in. NEVER commit the filled-in file.
# ============================================================

# ── Clerk authentication (required) ─────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── MongoDB (required for persistence) ──────────────────────
# Without this the app runs on an in-memory fallback store and the UI
# shows a "Degraded: no database" banner.
MONGODB_URI=
MONGODB_DB=aletsch_ai

# ── Encryption key for GitHub tokens at rest (required for OAuth) ──
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── GitHub OAuth App (required for private-repo support) ────
# https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Absolute base URL used to build the OAuth callback. Defaults to the
# incoming request origin when unset.
GITHUB_OAUTH_REDIRECT_BASE=http://localhost:3000

# ── GitHub fallback token (optional) ───────────────────────
# A classic PAT used ONLY when the signed-in user has not connected
# their GitHub account. Grants access to public repos for demos.
# Leave empty in production: per-user OAuth is the supported path.
GITHUB_TOKEN=

# ── LLM gateway via OpenRouter (optional but recommended) ───
# Without a key, semantic intent inference degrades to the
# deterministic rule engine and insights report "Insufficient data".
#
# AI_MODEL is optional. OpenRouter retires `:free` slugs without
# notice — when the configured one 404s, AIService falls through to a
# built-in candidate list rather than disabling the AI layer. Check
# https://openrouter.ai/models?max_price=0 for what is free today.
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# ── PostHog event infrastructure (optional) ─────────────────
# Project API key + host are written into generated instrumentation.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (scoped `query:read`) lets Aletsch read behavioural
# data back out of PostHog for journeys/funnels/insights.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
